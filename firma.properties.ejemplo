# Copia este archivo como «firma.properties» (en esta misma carpeta) y rellénalo.
# firma.properties y el keystore NO se suben a GitHub (están en .gitignore).
# Guarda una copia del keystore y las contraseñas en lugar seguro: sin ellos
# no podrás publicar actualizaciones que se instalen encima de la versión anterior.

storeFile=firma/dias-de-furia.jks
storePassword=TU_CONTRASEÑA
keyAlias=diasdefuria
keyPassword=TU_CONTRASEÑA
